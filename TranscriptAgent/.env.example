LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret

# Yating Developer Console API key. Never commit the real value.
YATING_API_KEY=replace_with_yating_api_key
# Mandarin with occasional English. Use asr-zh-tw-std for Mandarin + Taiwanese.
YATING_PIPELINE=asr-zh-en-std
# Optional custom language model ID from Yating Developer Console.
YATING_CUSTOM_MODEL_ID=

# Meeting MP3 recording
TRANSCRIPT_RECORDING_ENABLED=true
TRANSCRIPT_RECORDING_MAX_MINUTES=45
TRANSCRIPT_RECORDING_BITRATE_KBPS=48
TRANSCRIPT_RECORDING_CHUNK_BYTES=9000
TRANSCRIPT_RECORDING_MAX_TRANSFER_MB=32
TRANSCRIPT_RECORDING_CHUNK_DELAY_MS=2
TRANSCRIPT_RECORDING_FFMPEG_TIMEOUT_SECONDS=180

# AI collaboration: configure on the Agent only, never in Unity.
AI_ENABLED=false
# compatible: OpenAI-compatible Chat Completions; ollama: native /api/chat.
AI_PROVIDER=compatible
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Optional. Default is TranscriptAgent/knowledge. Accepts UTF-8 .md/.txt and text PDFs.
AI_KNOWLEDGE_DIR=
