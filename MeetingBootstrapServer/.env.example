LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-on-server
LIVEKIT_API_SECRET=replace-on-server

# Demo company/device credential. In production, use per-device credentials
# or authenticated company users instead of one shared company key.
EXAMPLE_COMPANY_DEVICE_KEY=replace-with-a-random-device-key

# All participant tokens are minted server-side and intentionally short-lived.
TOKEN_TTL_MINUTES=30

# The frontend/deep-link page that receives ?invite=<opaque-code>.
GUEST_JOIN_BASE_URL=https://meeting.example.com/join

# Scheduled meetings may be joined shortly before/after their planned window.
SCHEDULE_EARLY_JOIN_MINUTES=15
SCHEDULE_JOIN_GRACE_MINUTES=15

# Relative to the MeetingBootstrapServer working directory. This also resolves
# to /app/config/companies.json inside the supplied Docker image.
COMPANY_CONFIG_PATH=config/companies.json
